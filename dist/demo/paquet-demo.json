          "blocks": [
            { "type": "text", "text": "Le système solaire compte **huit planètes**, réparties en deux familles :\n- les planètes *telluriques*, proches du Soleil ;\n- les planètes *géantes*, plus éloignées." },
            { "type": "key_point", "text": "Telluriques = rocheuses (Mercure, Vénus, Terre, Mars). Géantes = Jupiter, Saturne, Uranus, Neptune." },
            { "type": "definition", "term": "Planète tellurique", "definition": "Planète principalement composée de roches et de métaux, à surface solide.", "concept_id": "P0-M01-C001", "source": { "source_id": "P0-DOC1", "location": "p. 1" } },
            { "type": "table", "title": "Comparer les deux familles", "columns": ["Critère", "Telluriques", "Géantes"], "rows": [["Composition", "Roches, métaux", "Gaz, glaces"], ["Taille", "Petite", "Très grande"], ["Anneaux", "Non", "Oui"]] },
            { "type": "pitfall", "text": "Uranus et Neptune ne sont pas telluriques, même si elles sont plus petites que Jupiter.", "concept_ids": ["P0-M01-C001", "P0-M01-C002"] }
          ]
        },
